{
  "maxerr": 50,
  "bitwise": false,
  "camelcase": true,
  "curly": true,
  "eqeqeq": true,
  "indent": 4,
  "latedef": "nofunc",
  "newcap": true,
  "noarg": true,
  "noempty": true,
  "trailing": true,
  "undef": true,
  "esnext": true,
  "browser": true,
  "node": false,
  "predef": [
    "log",
    "logError",
    "print",
    "printerr",
    "imports",
    "ARGV",
    "pkg",
    "_",
    "C_",
    "N_"
  ]
}
